# Copie este arquivo pra .env e preencha. O .env nunca vai pro git.

# Token do webservice do Moodle (obrigatorio).
# Perfil > Preferencias > Chaves de seguranca no AVA.
MOODLE_TOKEN=

# Chave da API do Google, pro tutor de IA (opcional).
# Gere de graca em https://aistudio.google.com/apikey
# Sem ela o app funciona normal, so nao abre o chat.
GEMINI_API_KEY=

# Modelo do Gemini (opcional). Modelos sao aposentados de tempos em tempos;
# quando isso acontece o app testa os outros da lista e usa o que responder.
# GEMINI_MODEL=gemini-3.5-flash
