# Copie este arquivo para .env e preencha. O .env fica so na sua maquina,
# nunca vai pro git (esta no .gitignore).
#
#     copy .env.exemplo .env        (Windows)
#     cp   .env.exemplo .env        (Linux/Mac)


# ---------------------------------------------------------------------------
# OBRIGATORIO
# ---------------------------------------------------------------------------

# Token do webservice do Moodle. E ele que da acesso as suas atividades.
# Como pegar: entre no AVA > clique no seu nome > Preferencias >
# Chaves de seguranca. Copie a chave do servico "Moodle mobile web service".
# Nao mostre esse token pra ninguem: ele vale como sua senha.
MOODLE_TOKEN=


# ---------------------------------------------------------------------------
# OPCIONAL - o assistente descobre sozinho se voce deixar em branco
# ---------------------------------------------------------------------------

# Endereco do seu Moodle, se voce nao for da Universidade de Vassouras.
# MOODLE_URL=https://moodle.suafaculdade.edu.br

# Seu ID de usuario no Moodle. Em branco, o proprio token informa qual e.
# MOODLE_USER_ID=

# Quais disciplinas acompanhar, separadas por virgula. Em branco, o assistente
# usa todas em que voce estiver matriculado. Preencha so se quiser ignorar
# alguma: o ID aparece na URL da disciplina (.../course/view.php?id=12345).
# MOODLE_COURSE_IDS=12345, 23456, 34567


# ---------------------------------------------------------------------------
# OPCIONAL - tutor de IA (clicar numa atividade abre um chat sobre ela)
# ---------------------------------------------------------------------------

# Chave da API do Google. Gere de graca em https://aistudio.google.com/apikey
# Sem ela o resto do app funciona igual, so nao abre o chat.
GEMINI_API_KEY=

# Modelo do Gemini. Modelos sao aposentados de tempos em tempos; quando isso
# acontece o app testa os outros disponiveis e usa o que responder.
# GEMINI_MODEL=gemini-3.5-flash
